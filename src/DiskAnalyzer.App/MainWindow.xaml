<Window x:Class="DiskAnalyzer.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        Title="{Binding AppTitle}"
        Width="1260"
        Height="780"
        MinWidth="920"
        MinHeight="620"
        Icon="Assets/Icons/DiskAnalyzer.ico"
        WindowStartupLocation="CenterScreen"
        Background="{DynamicResource WindowBackgroundBrush}">
    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Image Width="54"
                       Height="54"
                       VerticalAlignment="Center"
                       Source="Assets/Icons/disk-analyzer-icon-256.png"
                       Stretch="Uniform" />

                <StackPanel Grid.Column="1"
                            Margin="14,0,0,0"
                            VerticalAlignment="Center">
                    <TextBlock Style="{StaticResource AppTitleTextStyle}"
                               Text="{Binding AppTitle}" />
                    <TextBlock Margin="0,4,0,0"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="选择磁盘，快速定位占用空间最大的文件" />
                </StackPanel>
            </Grid>

            <Button Grid.Column="1"
                    Margin="16,0,0,0"
                    VerticalAlignment="Center"
                    Command="{Binding OpenFileLocationCommand}"
                    CommandParameter="{Binding SelectedFile}"
                    Content="打开文件位置"
                    Style="{StaticResource SecondaryButtonStyle}" />
        </Grid>

        <Border Grid.Row="1"
                Margin="0,22,0,14"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="360" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Margin="0,0,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="扫描磁盘" />
                    <ComboBox ItemsSource="{Binding Drives}"
                              SelectedItem="{Binding SelectedDrive}"
                              IsEnabled="{Binding CanSelectDrive}">
                        <ComboBox.ItemTemplate>
                            <DataTemplate>
                                <Grid Width="310">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="*" />
                                    </Grid.ColumnDefinitions>
                                    <TextBlock FontWeight="SemiBold"
                                               Text="{Binding Name}" />
                                    <TextBlock Grid.Column="1"
                                               Margin="12,0,0,0"
                                               Foreground="{DynamicResource SecondaryTextBrush}">
                                        <Run Text="剩余 " />
                                        <Run Text="{Binding FreeBytes, Converter={StaticResource FileSizeConverter}}" />
                                        <Run Text=" / " />
                                        <Run Text="{Binding TotalBytes, Converter={StaticResource FileSizeConverter}}" />
                                    </TextBlock>
                                </Grid>
                            </DataTemplate>
                        </ComboBox.ItemTemplate>
                    </ComboBox>
                </StackPanel>

                <StackPanel Grid.Column="1"
                            Margin="28,0,24,0"
                            VerticalAlignment="Bottom">
                    <TextBlock Margin="0,0,0,8"
                               FontSize="12"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="当前路径" />
                    <TextBlock Height="40"
                               VerticalAlignment="Center"
                               Text="{Binding CurrentPath}"
                               TextTrimming="CharacterEllipsis"
                               ToolTip="{Binding CurrentPath}" />
                </StackPanel>

                <Button Grid.Column="2"
                        Margin="0,20,10,0"
                        VerticalAlignment="Center"
                        Command="{Binding StartScanCommand}"
                        Content="开始扫描"
                        Style="{StaticResource PrimaryButtonStyle}" />

                <Button Grid.Column="3"
                        Margin="0,20,0,0"
                        VerticalAlignment="Center"
                        Command="{Binding CancelScanCommand}"
                        Content="取消"
                        Style="{StaticResource SecondaryButtonStyle}" />
            </Grid>
        </Border>

        <Border Grid.Row="2"
                Margin="0,0,0,14"
                Padding="18,14"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel>
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="已发现文件" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding FilesDiscovered, StringFormat={}{0:N0}}" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="已扫描大小" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding BytesDiscovered, Converter={StaticResource FileSizeConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="跳过项" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding SkippedItems, StringFormat={}{0:N0}}" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                               Text="耗时" />
                    <TextBlock Margin="0,4,0,0"
                               FontSize="20"
                               FontWeight="SemiBold"
                               Text="{Binding Elapsed, StringFormat={}{0:hh\\:mm\\:ss}}" />
                </StackPanel>

                <ProgressBar Grid.Row="1"
                             Grid.ColumnSpan="4"
                             Height="4"
                             Margin="0,14,0,0"
                             IsIndeterminate="{Binding IsScanning}"
                             Background="{DynamicResource BorderBrush}"
                             Foreground="{DynamicResource AccentBrush}" />
            </Grid>
        </Border>

        <Border Grid.Row="3"
                Padding="0"
                Style="{StaticResource CardStyle}">
            <DataGrid ItemsSource="{Binding FilesView}"
                      SelectedItem="{Binding SelectedFile}"
                      AutoGenerateColumns="False"
                      AlternationCount="2"
                      ScrollViewer.CanContentScroll="True"
                      VirtualizingPanel.IsVirtualizing="True"
                      VirtualizingPanel.VirtualizationMode="Recycling">
                <DataGrid.ContextMenu>
                    <ContextMenu>
                        <MenuItem Header="打开所在文件夹"
                                  Command="{Binding PlacementTarget.DataContext.OpenFileLocationCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}"
                                  CommandParameter="{Binding PlacementTarget.SelectedItem, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                    </ContextMenu>
                </DataGrid.ContextMenu>
                <DataGrid.Columns>
                    <DataGridTextColumn Width="220"
                                        Header="文件名"
                                        Binding="{Binding Name}"
                                        SortMemberPath="Name" />
                    <DataGridTextColumn Width="*"
                                        MinWidth="320"
                                        Header="完整路径"
                                        Binding="{Binding FullPath}"
                                        SortMemberPath="FullPath" />
                    <DataGridTextColumn Width="120"
                                        Header="大小"
                                        Binding="{Binding SizeBytes, Converter={StaticResource FileSizeConverter}}"
                                        SortDirection="Descending"
                                        SortMemberPath="SizeBytes" />
                    <DataGridTextColumn Width="90"
                                        Header="类型"
                                        Binding="{Binding Extension}"
                                        SortMemberPath="Extension" />
                    <DataGridTextColumn Width="160"
                                        Header="修改时间"
                                        Binding="{Binding LastWriteTime, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                        SortMemberPath="LastWriteTime" />
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <Grid Grid.Row="4" Margin="2,12,2,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <TextBlock Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="{Binding StatusMessage}" />
            <TextBlock Grid.Column="1"
                       Foreground="{DynamicResource SecondaryTextBrush}"
                       Text="点击列标题可排序，再次点击切换升序/降序" />
        </Grid>
    </Grid>
</Window>
